+function extractIPv4FromIPv6Segments(segments: number[]) {
+  if (segments.length !== 8) return null;
+
+  const isIPv4Mapped =
+    segments[0] === 0 &&
+    segments[1] === 0 &&
+    segments[2] === 0 &&
+    segments[3] === 0 &&
+    segments[4] === 0 &&
+    segments[5] === 0xffff;
+
+  const isIPv4Compatible =
+    segments[0] === 0 &&
+    segments[1] === 0 &&
+    segments[2] === 0 &&
+    segments[3] === 0 &&
+    segments[4] === 0 &&
+    segments[5] === 0 &&
+    (segments[6] !== 0 || segments[7] !== 0);
+
+  if (!isIPv4Mapped && !isIPv4Compatible) return null;
+
+  const octets = [
+    (segments[6] >> 8) & 0xff,
+    segments[6] & 0xff,
+    (segments[7] >> 8) & 0xff,
+    segments[7] & 0xff,
+  ];
+  return octets.join(".");
+}
